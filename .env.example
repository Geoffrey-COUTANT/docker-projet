# Copy to .env and replace every CHANGE_ME value with generated secrets.
# Local addresses work with Docker Desktop and recent Docker Engine.
RALLLY_DOMAIN=rallly.localhost
AUTHENTIK_DOMAIN=authentik.localhost

# Rallly
SECRET_PASSWORD=CHANGE_ME_generate_openssl_rand_base64_32
RALLLY_POSTGRES_PASSWORD=CHANGE_ME_generate_openssl_rand_hex_24
S3_ACCESS_KEY_ID=CHANGE_ME_generate_openssl_rand_hex_16
S3_SECRET_ACCESS_KEY=CHANGE_ME_generate_openssl_rand_hex_32
GARAGE_RPC_SECRET=CHANGE_ME_generate_openssl_rand_hex_32
SUPPORT_EMAIL=admin@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PWD=
SMTP_SECURE=false
NOREPLY_EMAIL=noreply@example.test
NEXT_PUBLIC_BASE_URL=https://rallly.localhost
OIDC_NAME=Authentik
OIDC_DISCOVERY_URL=https://authentik.localhost/application/o/rallly/.well-known/openid-configuration
OIDC_ISSUER_URL=https://authentik.localhost/application/o/rallly/
OIDC_CLIENT_ID=CHANGE_ME_after_creating_authentik_provider
OIDC_CLIENT_SECRET=CHANGE_ME_after_creating_authentik_provider

# Authentik
AUTHENTIK_SECRET_KEY=CHANGE_ME_generate_openssl_rand_base64_60
AUTHENTIK_POSTGRES_PASSWORD=CHANGE_ME_generate_openssl_rand_hex_24
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
RALLLY_TEST_PASSWORD=
AUTHENTIK_EMAIL__HOST=mailpit
AUTHENTIK_EMAIL__PORT=1025
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__FROM=authentik@example.test

# Optional in production. Caddy requests public certificates when using real DNS names.
ACME_EMAIL=admin@example.test
